<?xml version="1.0" encoding="utf-8"?>
<!--
    Legacy Auto Backup rules (Android 6–11).
    Exclude all data from Google cloud backup to preserve user privacy.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
